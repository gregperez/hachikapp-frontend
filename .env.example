# Server-side URL for the Go API. It is never exposed to the browser.
BACKEND_URL=http://localhost:8080

# Public URL used only to start the Google OIDC browser redirect.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional server-side Mastra adapter. Leave empty to use the preparation mode.
# Point to base-agent POST /v1/chat. The browser never sees these values.
AI_CHAT_ENDPOINT=http://localhost:4111/v1/chat
AI_CHAT_API_KEY=
ACTOR_CONTEXT_SECRET=
