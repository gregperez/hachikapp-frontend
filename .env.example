# Server-side URL for the Go API. It is never exposed to the browser.
BACKEND_URL=http://localhost:8080

# Public URL used only to start the Google OIDC browser redirect.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional server-side AI adapter. Leave empty to use the preparation mode.
# The endpoint receives { messages } and should return { message } or { text }.
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=
