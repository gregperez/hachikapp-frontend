# Server-side URL for the Go API. It is never exposed to the browser.
BACKEND_URL=http://localhost:8080

# Header holding the visitor's IP, forwarded to the API as X-Forwarded-For for
# its per-visitor rate limits. Unset or "x-forwarded-for": the LAST entry of
# x-forwarded-for (the hop added by the nearest proxy). Any other name (e.g.
# x-real-ip, cf-connecting-ip): that header as is. The frontend MUST run behind
# a proxy that sets or overwrites this header; otherwise clients choose their
# IP. The backend must list this server in AUTH_TRUSTED_PROXY_CIDRS.
CLIENT_IP_HEADER=

# Public URL used only to start the Google OIDC browser redirect.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional server-side Mastra adapter. Leave empty to use the preparation mode.
# Point to base-agent POST /v1/chat. The browser never sees these values.
AI_CHAT_ENDPOINT=http://localhost:4111/v1/chat
AI_CHAT_API_KEY=
ACTOR_CONTEXT_SECRET=
